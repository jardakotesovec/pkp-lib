{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Context (journal/press/server) scenario spec",
    "type": "object",
    "required": ["tag"],
    "additionalProperties": false,
    "properties": {
        "tag": { "type": "string", "minLength": 1, "maxLength": 64 },
        "path": { "type": "string" },
        "name": { "type": "object", "additionalProperties": true },
        "description": { "type": "object", "additionalProperties": true },
        "acronym": { "type": "object", "additionalProperties": true },
        "abbreviation": { "type": "object", "additionalProperties": true },
        "publisherInstitution": { "type": "string" },
        "primaryLocale": { "type": "string" },
        "supportedLocales": { "type": "array", "items": { "type": "string" } },
        "country": { "type": "string" },
        "copyrightNotice": { "type": "object", "additionalProperties": true },
        "submitWithCategories": { "type": "boolean" },
        "enableDois": { "type": "boolean" },
        "doiPrefix": { "type": "string" },
        "doiVersioning": { "type": "boolean" },
        "enabledDoiTypes": { "type": "array", "items": { "type": "string" } },
        "registrationAgency": { "type": "string" },
        "doiCreationTime": {
            "description": "When DOIs are assigned. 'copyEditCreationTime' (entity-schema default) and 'publicationCreationTime' mint automatically; 'neverCreationTime' requires manual assignment.",
            "enum": ["copyEditCreationTime", "publicationCreationTime", "neverCreationTime"]
        },
        "onlineIssn": { "type": "string" },
        "printIssn": { "type": "string" },
        "enablePublicComments": { "type": "boolean" },
        "enableAnnouncements": { "type": "boolean" },
        "publishingMode": { "type": "integer" },
        "keywords": {
            "description": "Submission-wizard keywords metadata mode. 0 disables; 'enable' shows in workflow only; 'request'/'require' expose it to authors.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "citations": {
            "description": "Submission-wizard citations (references) metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "citationsMetadataLookup": {
            "description": "References Metadata Lookup. When true, the References tab opens the structured citation edit form and exposes the Reprocess actions; off by default.",
            "type": "boolean"
        },
        "subjects": {
            "description": "Submission-wizard subjects metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "disciplines": {
            "description": "Submission-wizard disciplines metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "agencies": {
            "description": "Submission-wizard supporting-agencies metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "coverage": {
            "description": "Submission-wizard coverage metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "rights": {
            "description": "Submission-wizard rights metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "source": {
            "description": "Submission-wizard source metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "type": {
            "description": "Submission-wizard type metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "fundingStatement": {
            "description": "Submission-wizard funding-statement metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "dataAvailability": {
            "description": "Submission-wizard data-availability-statement metadata mode. Same values as keywords.",
            "enum": [0, "0", "enable", "request", "require"]
        },
        "reviewerSuggestionEnabled": { "type": "boolean" },
        "reviewerAccessKeysEnabled": { "type": "boolean" },
        "defaultReviewMode": {
            "description": "1 = anonymous reviewer / disclosed author, 2 = double anonymous, 3 = open.",
            "enum": [1, 2, 3]
        },
        "numWeeksPerResponse": { "type": "integer", "minimum": 0 },
        "numWeeksPerReview": { "type": "integer", "minimum": 0 },
        "numDaysBeforeReviewResponseReminderDue": { "type": "integer", "minimum": 0, "maximum": 14 },
        "numDaysAfterReviewResponseReminderDue": { "type": "integer", "minimum": 0, "maximum": 14 },
        "numDaysBeforeReviewSubmitReminderDue": { "type": "integer", "minimum": 0, "maximum": 14 },
        "numDaysAfterReviewSubmitReminderDue": { "type": "integer", "minimum": 0, "maximum": 14 },
        "plugins": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "enabled": { "type": "boolean" },
                    "settings": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "sections": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["abbrev", "title"],
                "additionalProperties": true,
                "properties": {
                    "abbrev": { "type": "object" },
                    "title": { "type": "object" },
                    "wordCount": { "type": "integer", "minimum": 0 },
                    "identifyType": { "type": "object" },
                    "abstractsNotRequired": { "type": "boolean" },
                    "editorRestricted": { "type": "boolean" },
                    "sectionEditors": { "type": "array", "items": { "type": "string" } }
                }
            }
        },
        "categories": {
            "type": "array",
            "items": { "$ref": "#/$defs/category" }
        },
        "reviewForms": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["title", "elements"],
                "additionalProperties": false,
                "properties": {
                    "title": { "$ref": "#/$defs/localizedString" },
                    "description": { "$ref": "#/$defs/localizedString" },
                    "elements": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": ["type", "question"],
                            "additionalProperties": false,
                            "properties": {
                                "type": {
                                    "enum": ["smalltextfield", "textfield", "textarea", "checkboxes", "radiobuttons", "dropdown", "dropdownbox"]
                                },
                                "question": { "$ref": "#/$defs/localizedString" },
                                "required": { "type": "boolean" },
                                "includedInReview": { "type": "boolean" },
                                "options": {
                                    "type": "array",
                                    "minItems": 1,
                                    "items": { "$ref": "#/$defs/localizedString" }
                                }
                            }
                        }
                    }
                }
            }
        },
        "issues": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": true
            }
        },
        "contact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string" },
                "email": { "type": "string" }
            }
        },
        "users": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["username"],
                "additionalProperties": false,
                "properties": {
                    "username": { "type": "string", "minLength": 1 },
                    "roles": { "type": "array", "items": { "type": "string" } },
                    "password": { "type": "string", "minLength": 1 },
                    "email": { "type": "string" },
                    "givenName": { "type": "string" },
                    "familyName": { "type": "string" },
                    "country": { "type": "string" },
                    "affiliation": { "type": "string" },
                    "locale": { "type": "string" },
                    "mustChangePassword": { "type": "boolean" }
                }
            }
        }
    },
    "$defs": {
        "localizedString": {
            "oneOf": [
                { "type": "string" },
                { "type": "object", "additionalProperties": { "type": "string" } }
            ]
        },
        "category": {
            "type": "object",
            "required": ["path", "title"],
            "additionalProperties": false,
            "properties": {
                "path": { "type": "string" },
                "title": { "type": "object" },
                "children": { "type": "array", "items": { "$ref": "#/$defs/category" } }
            }
        }
    }
}
