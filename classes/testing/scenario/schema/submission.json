{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Submission scenario spec (context-agnostic)",
    "type": "object",
    "required": ["tag", "submitter"],
    "anyOf": [
        { "required": ["context"] },
        { "required": ["journal"] }
    ],
    "additionalProperties": false,
    "properties": {
        "tag": { "type": "string", "minLength": 1, "maxLength": 64 },
        "context": {
            "description": "urlPath of the owning context (journal / press / server) the submission is created in.",
            "type": "string",
            "minLength": 1
        },
        "journal": {
            "description": "DEPRECATED back-compat alias for `context`, kept so the existing OJS fixtures keep working. New specs use `context`. When both are present `context` wins.",
            "type": "string",
            "minLength": 1
        },
        "submitter": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" },
        "submitted": { "type": "boolean" },
        "commentsForEditor": { "type": "string" },

        "author": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "orcid": { "type": "string" },
                "orcidIsVerified": { "type": "boolean" },
                "email": { "type": "string" }
            }
        },

        "participants": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["user", "role"],
                "additionalProperties": false,
                "properties": {
                    "user": { "type": "string" },
                    "role": { "type": "string" },
                    "recommendOnly": { "type": "boolean" },
                    "canChangeMetadata": { "type": "boolean" }
                }
            }
        },

        "decisions": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["type", "by"],
                "additionalProperties": false,
                "properties": {
                    "type": { "type": "string" },
                    "by": { "type": "string" },
                    "toAuthor": { "type": "string" },
                    "toReviewers": { "type": ["string", "object"] },
                    "toEditor": { "type": "string" }
                }
            }
        },

        "reviewRounds": {
            "description": "Review rounds, consumed in order by the round-creating decisions in decisions[]. Each entry may declare the review stage it belongs to; the declaration is verified against the round the decision actually created, so a mis-ordered fixture fails loudly instead of seeding the wrong stage.",
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "stage": {
                        "description": "Which review stage this round belongs to. 'external' (the default) exists in every app; 'internal' only exists where the app has an internal review stage (OMP). Optional — omit to accept whatever stage the preceding round-creating decision produced.",
                        "enum": ["internal", "external"]
                    },
                    "reviewers": {
                        "type": "array",
                        "items": { "$ref": "#/$defs/reviewer" }
                    }
                }
            }
        },

        "reviewerSuggestions": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["givenName", "familyName", "email"],
                "additionalProperties": false,
                "properties": {
                    "givenName": { "type": "string", "minLength": 1 },
                    "familyName": { "type": "string", "minLength": 1 },
                    "email": { "type": "string", "minLength": 3 },
                    "affiliation": { "type": "string" },
                    "suggestionReason": { "type": "string" }
                }
            }
        },

        "userComments": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["user", "text"],
                "additionalProperties": false,
                "properties": {
                    "user": { "type": "string", "minLength": 1 },
                    "text": { "type": "string", "minLength": 1 },
                    "approved": { "type": "boolean" }
                }
            }
        },

        "publications": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/publication" }
        }
    },

    "$defs": {
        "reviewer": {
            "type": "object",
            "required": ["user"],
            "additionalProperties": false,
            "properties": {
                "user": { "type": "string" },
                "method": { "type": "string", "enum": ["anonymous", "doubleAnonymous", "open"] },
                "responseDueDate": { "type": "string" },
                "reviewDueDate": { "type": "string" },
                "status": {
                    "type": "string",
                    "enum": ["invited", "accepted", "declined", "completed", "cancelled"]
                },
                "recommendation": {
                    "type": "string",
                    "enum": ["accept", "pendingRevisions", "resubmitHere", "resubmitElsewhere", "decline", "seeComments"]
                },
                "comments": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "toEditor": { "type": "string" },
                        "toAuthor": { "type": "string" }
                    }
                },
                "reviewForm": { "type": "string", "minLength": 1 }
            }
        },

        "publication": {
            "description": "Cross-app publication properties only. The publishing-container and representation properties (`issue`, `galleys`, `mediaFiles` in OJS; `publicationFormats` in OMP) are app overlays declared by each app's SubmissionScenarioController via schemaOverlayDefProperties()['publication'], and $ref the reusable $defs below.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "versionStage": { "type": "string", "enum": ["AO", "PMUR", "VoR"] },
                "versionIsMinor": { "type": "boolean" },
                "jatsPublicVisibility": { "type": "boolean" },
                "metadata": {
                    "type": "object",
                    "additionalProperties": true
                },
                "categories": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "published": { "type": "boolean" }
            }
        },

        "issue": {
            "description": "App overlay building block (OJS). Referenced from the OJS publication overlay as { \"$ref\": \"#/$defs/issue\" }.",
            "oneOf": [
                { "type": "string", "enum": ["latest", "current"] },
                {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "volume": { "type": ["integer", "null"] },
                        "number": { "type": ["integer", "string", "null"] },
                        "year": { "type": ["integer", "null"] }
                    }
                }
            ]
        },

        "galley": {
            "type": "object",
            "required": ["label"],
            "additionalProperties": false,
            "properties": {
                "label": { "type": "string", "minLength": 1 },
                "locale": { "type": "string" },
                "file": { "type": "string", "minLength": 1 },
                "urlRemote": { "type": "string", "minLength": 1 }
            }
        },

        "mediaFile": {
            "type": "object",
            "required": ["variantType"],
            "additionalProperties": false,
            "properties": {
                "file": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "genre": { "type": "string", "enum": ["IMAGE", "ARTICLE"] },
                "variantType": { "type": "string", "enum": ["web", "high_resolution"] },
                "group": { "type": "string", "minLength": 1 }
            }
        }
    }
}
